# Copy this file to apps/web/.env before running any database or auth script.
#
# Matches the credentials in the repository root compose.yaml.
# Used by drizzle-kit, the migration runner and the seed script.
DATABASE_URL=postgresql://avexa:avexa@localhost:5432/avexa

# Better Auth — generate a local secret with: openssl rand -base64 32
# Never commit real secrets. Never use NEXT_PUBLIC_* for these.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
